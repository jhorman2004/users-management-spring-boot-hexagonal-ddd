# users-service — copie este archivo como .environments/application-secrets.properties.
# Reemplace todos los valores de ejemplo. Nunca versionar el archivo real.

# Base de datos local (MySQL instalado en el PC; con el MySQL de compose: port=3307, username=users_app)
db.host=localhost
db.port=3306
db.name=crud_usuarios
db.username=root
db.password=REEMPLAZAR

# JWT: Base64 de al menos 32 bytes aleatorios (openssl rand -base64 32)
jwt.secret=REEMPLAZAR

# Clave compartida con accounts-service (la misma que internal.api-key en accounts-secrets)
accounts.api-key=REEMPLAZAR_MINIMO_16_CARACTERES
