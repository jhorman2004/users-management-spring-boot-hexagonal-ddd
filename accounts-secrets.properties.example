# accounts-service — copie este archivo como .environments/accounts-secrets.properties.
# Reemplace todos los valores de ejemplo. Nunca versionar el archivo real.

# Base de datos de cuentas (antes ejecute accounts-service/src/main/resources/schema.sql)
db.host=localhost
db.port=3306
db.name=crud_cuentas
db.username=root
db.password=REEMPLAZAR

# Clave compartida con users-service (la misma que accounts.api-key en application-secrets)
internal.api-key=REEMPLAZAR_MINIMO_16_CARACTERES
