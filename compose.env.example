# Copie este archivo como .env antes de ejecutar Docker Compose.
# Nunca agregue el archivo .env real al repositorio.

DB_PASSWORD=REEMPLAZAR
MYSQL_ROOT_PASSWORD=REEMPLAZAR
JWT_SECRET=REEMPLAZAR_CON_BASE64_DE_32_BYTES
JWT_EXPIRATION_SECONDS=900

# Clave compartida users-service <-> accounts-service (mínimo 16 caracteres).
# Generarla con: openssl rand -base64 32
INTERNAL_API_KEY=REEMPLAZAR

# notifier-service: con "local" solo registra los correos en el log. Para enviarlos de verdad,
# deje NOTIFIER_PROFILE vacío y complete las variables de Brevo.
NOTIFIER_PROFILE=local
BREVO_API_KEY=xkeysib-REEMPLAZAR
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios
